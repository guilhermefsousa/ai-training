<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Módulo 07 — Ferramentas de IA para Devs</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#0f172a;--bg2:#1e293b;--bg3:#334155;--purple:#8b5cf6;--blue:#3b82f6;--green:#10b981;--amber:#f59e0b;--rose:#f43f5e;--cyan:#06b6d4;--text:#f1f5f9;--text2:#94a3b8;--text3:#64748b;--card:rgba(255,255,255,.05);--border:rgba(255,255,255,.08)}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6;overflow-x:hidden}
.topnav{position:sticky;top:0;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:12px 24px;background:rgba(15,23,42,.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}
.topnav a{color:var(--text2);text-decoration:none;font-size:13px;font-family:monospace;transition:.2s}.topnav a:hover{color:var(--purple)}.nav-badge{font-size:11px;color:var(--cyan);background:rgba(6,182,212,.1);padding:4px 12px;border-radius:20px;border:1px solid rgba(6,182,212,.2)}.nav-links{display:flex;gap:16px}
main{position:relative;z-index:1}.section{max-width:960px;margin:0 auto;padding:80px 24px;border-bottom:1px solid var(--border)}.section:last-child{border-bottom:none}
.section-header{display:flex;align-items:flex-start;gap:20px;margin-bottom:40px}.section-number{width:48px;height:48px;border-radius:12px;background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.3);display:flex;align-items:center;justify-content:center;font-family:monospace;font-size:20px;font-weight:700;color:var(--purple);flex-shrink:0}
.section-header h2{font-size:clamp(24px,4vw,36px);font-weight:800;margin-bottom:6px}.section-header p{color:var(--text2);font-size:14px}
.eco-map{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;margin-bottom:32px}.eco-cat{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;text-align:center;transition:.3s}.eco-cat:hover{transform:translateY(-3px);border-color:var(--purple)}.eco-cat-icon{font-size:28px;margin-bottom:8px}.eco-cat-name{font-size:13px;font-weight:600;margin-bottom:4px}.eco-cat-count{font-size:11px;color:var(--text3);font-family:monospace}
.quiz-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:32px;margin-bottom:24px}.quiz-q{font-size:16px;font-weight:600;margin-bottom:16px}.quiz-opts{display:flex;flex-direction:column;gap:8px}.quiz-opt{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:8px;padding:12px 16px;cursor:pointer;transition:.2s;text-align:left;font-size:14px;color:var(--text)}.quiz-opt:hover{border-color:var(--purple);background:rgba(139,92,246,.08)}.quiz-opt.selected{border-color:var(--purple);background:rgba(139,92,246,.15)}.quiz-result{margin-top:24px;padding:20px;border-radius:12px;background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.2);display:none}.quiz-result.show{display:block}
.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;border:none;transition:.2s}.btn-primary{background:var(--purple);color:#fff}.btn-primary:hover{background:#7c3aed}.btn-outline{background:transparent;color:var(--text);border:1px solid var(--border)}.btn-outline:hover{border-color:var(--purple);color:var(--purple)}.btn-home{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:8px;font-size:14px;background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.3);color:var(--purple);text-decoration:none;transition:.2s}.btn-home:hover{background:rgba(139,92,246,.2)}
.tool-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;margin-bottom:24px}.tool-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:20px;transition:.3s}.tool-card:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.15)}.tool-card .tc-icon{font-size:24px;margin-bottom:10px}.tool-card h3{font-size:15px;font-weight:700;margin-bottom:6px}.tool-card p{font-size:13px;color:var(--text2);line-height:1.5}.tc-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.tc-tag{font-size:11px;padding:2px 8px;border-radius:20px;border:1px solid var(--border);color:var(--text3);font-family:monospace}
.mcp-arch{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:32px;margin-bottom:24px}.mcp-layer{display:flex;align-items:center;gap:16px;padding:16px;border-radius:8px;margin-bottom:8px}.mcp-layer-label{font-size:11px;font-family:monospace;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:var(--text3);width:80px;flex-shrink:0}.mcp-boxes{display:flex;gap:8px;flex-wrap:wrap}.mcp-box{padding:8px 14px;border-radius:6px;font-size:13px;font-weight:600;border:1px solid}
.expand-card{background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:12px}.expand-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;cursor:pointer;user-select:none}.expand-header:hover .expand-title{color:var(--purple)}.expand-title{font-weight:600;font-size:14px}.expand-arrow{color:var(--text3);transition:.3s}.expand-card.open .expand-arrow{transform:rotate(180deg)}.expand-body{padding:0 20px;max-height:0;overflow:hidden;transition:.3s}.expand-card.open .expand-body{max-height:600px;padding-bottom:20px}
.matrix-table{width:100%;border-collapse:collapse;margin-bottom:24px}.matrix-table th,.matrix-table td{padding:12px 16px;text-align:left;border-bottom:1px solid var(--border);font-size:13px}.matrix-table th{font-size:11px;font-family:monospace;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text3)}.matrix-table tr:hover td{background:rgba(255,255,255,.02)}.score-badge{display:inline-flex;width:24px;height:24px;align-items:center;justify-content:center;border-radius:50%;font-size:11px;font-weight:700}.score-5{background:rgba(16,185,129,.2);color:var(--green)}.score-4{background:rgba(59,130,246,.2);color:var(--blue)}.score-3{background:rgba(245,158,11,.2);color:var(--amber)}.score-1{background:rgba(244,63,94,.2);color:var(--rose)}
.fq-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:16px}.fq-card.answered-correct{border-color:rgba(16,185,129,.4)}.fq-card.answered-wrong{border-color:rgba(244,63,94,.4)}.fq-q{font-size:15px;font-weight:600;margin-bottom:14px}.fq-opts{display:flex;flex-direction:column;gap:8px}.fq-opt{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:8px;padding:10px 14px;cursor:pointer;font-size:13px;text-align:left;color:var(--text);transition:.2s}.fq-opt:hover{border-color:var(--purple)}.fq-opt.correct{background:rgba(16,185,129,.15);border-color:rgba(16,185,129,.5);color:var(--green)}.fq-opt.wrong{background:rgba(244,63,94,.1);border-color:rgba(244,63,94,.4);color:var(--rose)}.fq-fb{font-size:13px;color:var(--text2);margin-top:12px;padding-top:12px;border-top:1px solid var(--border);display:none}.fq-fb.show{display:block}
.completion-banner{background:linear-gradient(135deg,rgba(139,92,246,.2),rgba(59,130,246,.2));border:1px solid rgba(139,92,246,.4);border-radius:20px;padding:40px;text-align:center;margin-top:40px;display:none}.completion-banner.show{display:block}.score-ring{width:100px;height:100px;border-radius:50%;background:conic-gradient(var(--purple) 0deg,rgba(139,92,246,.15) 0deg);border:3px solid rgba(139,92,246,.4);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:28px;font-weight:800;color:var(--purple)}.completion-banner h3{font-size:24px;font-weight:800;margin-bottom:8px}.completion-banner p{color:var(--text2);font-size:15px;margin-bottom:24px}
.scenario-result{margin-top:12px;font-size:13px;padding:10px 14px;border-radius:8px;display:none}.scenario-result.show{display:block}.scenario-result.ok{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:var(--green)}.scenario-result.err{background:rgba(244,63,94,.08);border:1px solid rgba(244,63,94,.3);color:var(--rose)}
.mcp-cb-label{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;border:1px solid var(--border);cursor:pointer;font-size:13px;margin-bottom:6px;transition:.2s;user-select:none}.mcp-cb-label.checked{background:rgba(139,92,246,.1);border-color:rgba(139,92,246,.4)}.mcp-cb-label input{display:none}.mcp-feedback{margin-top:12px;font-size:13px;padding:10px;border-radius:8px;display:none}.mcp-feedback.show{display:block}.mcp-feedback.ok{background:rgba(16,185,129,.1);color:var(--green)}.mcp-feedback.err{background:rgba(244,63,94,.08);color:var(--rose)}
.fw-quiz{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:24px}.fw-q{font-size:14px;font-weight:600;margin-bottom:12px}.fw-opts{display:flex;flex-direction:column;gap:6px}.fw-opt{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:6px;padding:8px 12px;cursor:pointer;font-size:13px;text-align:left;color:var(--text);transition:.2s}.fw-opt:hover,.fw-opt.sel{border-color:var(--blue);background:rgba(59,130,246,.1)}.fw-result{margin-top:16px;font-size:13px;display:none}.fw-result.show{display:block}
.tool-quiz{background:var(--card);border:2px solid rgba(139,92,246,.3);border-radius:16px;padding:32px;margin-bottom:32px}.tool-quiz h3{font-size:18px;font-weight:700;margin-bottom:6px;color:var(--purple)}.tool-quiz .tq-sub{font-size:13px;color:var(--text2);margin-bottom:24px}.tq-step{display:none}.tq-step.active{display:block}.tq-q{font-size:16px;font-weight:600;margin-bottom:16px}.tq-opts{display:flex;flex-direction:column;gap:10px}.tq-opt{background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:10px;padding:14px 18px;cursor:pointer;transition:.2s;display:flex;gap:12px;align-items:flex-start}.tq-opt:hover{border-color:var(--purple);background:rgba(139,92,246,.1)}.tq-opt-icon{font-size:20px}.tq-opt-text strong{display:block;font-size:14px;font-weight:600;margin-bottom:2px}.tq-opt-text span{font-size:12px;color:var(--text2)}.tq-progress{font-size:12px;color:var(--text3);font-family:monospace;margin-bottom:16px}
.tq-result{display:none;text-align:center;padding:24px}.tq-result.show{display:block}.tq-result-icon{font-size:64px;margin-bottom:16px}.tq-result h4{font-size:22px;font-weight:800;margin-bottom:8px}.tq-result p{color:var(--text2);font-size:14px;margin-bottom:20px}.tq-result .tq-features{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}.tq-feature{font-size:12px;padding:4px 12px;border-radius:20px;background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.3);color:var(--purple)}
@media(max-width:640px){.section{padding:48px 16px}.tool-grid{grid-template-columns:1fr}.eco-map{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<nav class="topnav">
<div class="nav-links"><a href="../index.html">&larr; In&iacute;cio</a><a href="06-eval.html">&larr; M&oacute;dulo 6</a></div>
<span class="nav-badge">M&oacute;dulo 07</span>
</nav>
<main>
<section id="ecossistema">
<div class="section-header"><div class="section-number">1</div><div><h2>Ecossistema de IA em 2026</h2><p>6 categorias essenciais.</p></div></div>
<div class="eco-map">
<div class="eco-cat"><div class="eco-cat-icon">&#9000;&#65039;</div><div class="eco-cat-name">Assistentes de Código</div><div class="eco-cat-tools">Copilot · Claude Code · Cursor · Windsurf · Aider</div></div>
<div class="eco-cat"><div class="eco-cat-icon">&#128268;</div><div class="eco-cat-name">MCP</div><div class="eco-cat-tools">Postgres · GitHub · Slack · Playwright · Memory</div></div>
<div class="eco-cat"><div class="eco-cat-icon">&#129302;</div><div class="eco-cat-name">Frameworks Agentes</div><div class="eco-cat-tools">CrewAI · LangGraph · Agent SDK · AutoGen · Pydantic AI</div></div>
<div class="eco-cat"><div class="eco-cat-icon">&#129514;</div><div class="eco-cat-name">Eval &amp; Observabilidade</div><div class="eco-cat-tools">Promptfoo · Braintrust · LangSmith · Langfuse · Helicone</div></div>
<div class="eco-cat"><div class="eco-cat-icon">&#129504;</div><div class="eco-cat-name">Modelos &amp; APIs</div><div class="eco-cat-tools">Claude · GPT-4o · Gemini · Llama 4 · DeepSeek · Mistral</div></div>
<div class="eco-cat"><div class="eco-cat-icon">&#127912;</div><div class="eco-cat-name">IA Generativa</div><div class="eco-cat-tools">DALL-E · ElevenLabs · Suno · Runway · Whisper · NotebookLM</div></div>
</div>
</section>
<section id="assistentes">
<div class="section-header"><div class="section-number">2</div><div><h2>Assistentes de Código</h2><p>De autocomplete simples a agentes autônomos.</p></div></div>
<div class="cards-grid">
<div class="card"><span class="price-tag">$10/mês</span><div class="card-icon" style="background:rgba(16,185,129,0.15)">&#129309;</div><h3>GitHub Copilot</h3><p>O pioneiro. Integrado ao VS Code e todos os principais IDEs. Autocomplete, chat inline e geração de testes. Melhor para times que já usam GitHub.</p><span class="tag tag-green">Autocomplete</span><span class="tag tag-blue">IDE nativo</span></div>
<div class="card"><span class="price-tag" style="color:var(--purple-light);background:rgba(139,92,246,0.12);border-color:rgba(139,92,246,0.3)">Claude Max</span><div class="card-icon" style="background:rgba(139,92,246,0.15)">&#128156;</div><h3>Claude Code</h3><p>Agente autônomo no terminal e em qualquer IDE. Entende bases de código grandes, cria commits, roda testes e itera sem intervenção.</p><span class="tag tag-purple">Agente autônomo</span><span class="tag tag-purple">Multi-arquivo</span></div>
<div class="card"><span class="price-tag">$20/mês</span><div class="card-icon" style="background:rgba(59,130,246,0.15)">&#9889;</div><h3>Cursor</h3><p>Fork do VS Code com IA profunda. Composer edita múltiplos arquivos de uma vez. Suporta Claude, GPT-4o e modelos locais.</p><span class="tag tag-blue">IDE completo</span><span class="tag tag-yellow">Multi-model</span></div>
<div class="card"><span class="price-tag" style="color:var(--green-light);background:rgba(16,185,129,0.12);border-color:rgba(16,185,129,0.25)">Free tier</span><div class="card-icon" style="background:rgba(20,184,166,0.15)">&#127754;</div><h3>Windsurf</h3><p>Editor da Codeium com o agente Cascade. Navega o codebase autonomamente, cria e edita arquivos em fluxo contínuo. Tier gratuito generoso.</p><span class="tag tag-teal">Cascade agent</span><span class="tag tag-green">Free tier</span></div>
<div class="card"><span class="price-tag" style="color:var(--purple-light);background:rgba(139,92,246,0.12);border-color:rgba(139,92,246,0.3)">Open Source</span><div class="card-icon" style="background:rgba(245,158,11,0.15)">&#128296;</div><h3>Aider</h3><p>CLI open source para pair programming com LLMs. Funciona com qualquer modelo (OpenAI, Anthropic, Ollama). Controle total e custo zero.</p><span class="tag tag-yellow">CLI open source</span><span class="tag tag-orange">Multi-model</span></div>
</div>
<div class="exercise"><div class="exercise-title">&#127919; Exercício: Qual Assistente é Para Você? <span class="badge">QUIZ</span></div>
<div id="tool-quiz">
<div class="quiz-question" id="tq1"><p>1. Como você prefere trabalhar?</p><div class="quiz-options"><label class="quiz-option" onclick="selectOpt(this,'tq1','a')"><input type="radio"> &#128421;&#65039; No terminal</label><label class="quiz-option" onclick="selectOpt(this,'tq1','b')"><input type="radio"> &#128433;&#65039; No IDE visual</label><label class="quiz-option" onclick="selectOpt(this,'tq1','c')"><input type="radio"> &#128256; Indiferente</label></div></div>
<div class="quiz-question" id="tq2"><p>2. Orçamento mensal?</p><div class="quiz-options"><label class="quiz-option" onclick="selectOpt(this,'tq2','a')"><input type="radio"> Zero — open source</label><label class="quiz-option" onclick="selectOpt(this,'tq2','b')"><input type="radio"> Até $20/mês</label><label class="quiz-option" onclick="selectOpt(this,'tq2','c')"><input type="radio"> Acima de $20</label></div></div>
<div class="quiz-question" id="tq3"><p>3. Caso de uso principal?</p><div class="quiz-options"><label class="quiz-option" onclick="selectOpt(this,'tq3','a')"><input type="radio"> Autocomplete enquanto digito</label><label class="quiz-option" onclick="selectOpt(this,'tq3','b')"><input type="radio"> Agente que executa tarefas longas</label><label class="quiz-option" onclick="selectOpt(this,'tq3','c')"><input type="radio"> Editar múltiplos arquivos</label></div></div>
<div class="quiz-question" id="tq4"><p>4. Controle sobre o modelo?</p><div class="quiz-options"><label class="quiz-option" onclick="selectOpt(this,'tq4','a')"><input type="radio"> Total — escolho por tarefa</label><label class="quiz-option" onclick="selectOpt(this,'tq4','b')"><input type="radio"> Zero — só funcionar</label><label class="quiz-option" onclick="selectOpt(this,'tq4','c')"><input type="radio"> Algum — poucas opções</label></div></div>
<div class="quiz-question" id="tq5"><p>5. Usa GitHub como plataforma principal?</p><div class="quiz-options"><label class="quiz-option" onclick="selectOpt(this,'tq5','a')"><input type="radio"> Sim, tudo no GitHub</label><label class="quiz-option" onclick="selectOpt(this,'tq5','b')"><input type="radio"> Não, GitLab/Bitbucket</label><label class="quiz-option" onclick="selectOpt(this,'tq5','c')"><input type="radio"> Tanto faz</label></div></div>
<button class="quiz-submit" id="tool-quiz-btn" onclick="calcToolQuiz()" disabled>Ver minha recomendação &rarr;</button>
</div>
<div id="tool-quiz-result" class="quiz-result"><div class="result-icon" id="tqr-icon"></div><div class="result-name" id="tqr-name"></div><div class="result-desc" id="tqr-desc"></div><div id="tqr-tags"></div><div class="divider"></div><p style="font-size:0.82rem;color:var(--text-muted)">Não se prenda à recomendação — experimente!</p><button onclick="resetToolQuiz()" style="margin-top:0.8rem;background:none;border:1px solid var(--border);color:var(--text-muted);padding:0.4rem 1rem;border-radius:6px;cursor:pointer;font-size:0.8rem">Refazer quiz</button></div>
</div>
</section>
<section id="mcp"><div class="section-header"><div class="section-number">3</div><div><h2>MCP — Model Context Protocol</h2><p>O protocolo aberto que conecta modelos de IA a qualquer ferramenta.</p></div></div>
<div class="mcp-arch"><div class="mcp-box"><div class="label">Você</div><div class="name">&#129489;&#8205;&#128187; Dev / IDE</div></div><div class="mcp-arrow">&harr;</div><div class="mcp-box"><div class="label">Modelo</div><div class="name">&#129504; LLM</div></div><div class="mcp-arrow">&harr;</div><div class="mcp-protocol"><div class="label">Protocolo</div><div class="name">&#128268; MCP</div></div><div class="mcp-arrow">&harr;</div><div class="mcp-box"><div class="label">Servidor</div><div class="name">&#128374;&#65039; MCP Server</div></div><div class="mcp-arrow">&harr;</div><div class="mcp-box"><div class="label">Recurso</div><div class="name">&#127760; Tool</div></div></div>
<div class="expand-card" onclick="toggleExpand(this)"><div class="expand-header"><div class="expand-header-left"><span class="expand-icon">&#128024;</span><div><div class="expand-name">Postgres</div><div class="expand-sub">SQL via linguagem natural</div></div></div><span class="expand-chevron">&#9660;</span></div><div class="expand-body"><p>O modelo inspeciona schema, faz queries e retorna dados sem você escrever SQL.</p><div class="expand-example">&quot;Quais os 10 clientes com mais pedidos nos últimos 30 dias?&quot;<br>&rarr; Consulta o banco e retorna resultado formatado.</div></div></div>
<div class="expand-card" onclick="toggleExpand(this)"><div class="expand-header"><div class="expand-header-left"><span class="expand-icon">&#128025;</span><div><div class="expand-name">GitHub</div><div class="expand-sub">Issues, PRs e código</div></div></div><span class="expand-chevron">&#9660;</span></div><div class="expand-body"><p>O modelo abre issues, cria PRs, revisa código e faz commit via linguagem natural.</p><div class="expand-example">&quot;Abra issue sobre o bug de login do PR #142&quot;<br>&rarr; Cria issue com title, body e labels.</div></div></div>
<div class="expand-card" onclick="toggleExpand(this)"><div class="expand-header"><div class="expand-header-left"><span class="expand-icon">&#128172;</span><div><div class="expand-name">Slack</div><div class="expand-sub">Mensagens e histórico</div></div></div><span class="expand-chevron">&#9660;</span></div><div class="expand-body"><p>Envia mensagens, lê canais e resume conversas.</p><div class="expand-example">&quot;Resuma o canal #eng-backend dos últimos 3 dias&quot;<br>&rarr; Retorna resumo estruturado.</div></div></div>
<div class="expand-card" onclick="toggleExpand(this)"><div class="expand-header"><div class="expand-header-left"><span class="expand-icon">&#128193;</span><div><div class="expand-name">Filesystem</div><div class="expand-sub">Arquivos locais</div></div></div><span class="expand-chevron">&#9660;</span></div><div class="expand-body"><p>Leitura e escrita controlada de arquivos dentro de um escopo definido.</p><div class="expand-example">&quot;Leia todos .md em /docs e gere índice&quot;<br>&rarr; Cria sumário automaticamente.</div></div></div>
<div class="expand-card" onclick="toggleExpand(this)"><div class="expand-header"><div class="expand-header-left"><span class="expand-icon">&#127917;</span><div><div class="expand-name">Playwright</div><div class="expand-sub">Browser real</div></div></div><span class="expand-chevron">&#9660;</span></div><div class="expand-body"><p>O modelo navega páginas, clica, preenche formulários e faz screenshot.</p><div class="expand-example">&quot;Acesse o dashboard e gere screenshot dos relatórios&quot;<br>&rarr; Executa e retorna screenshot.</div></div></div>
<div class="expand-card" onclick="toggleExpand(this)"><div class="expand-header"><div class="expand-header-left"><span class="expand-icon">&#129504;</span><div><div class="expand-name">Memory</div><div class="expand-sub">Memória persistente</div></div></div><span class="expand-chevron">&#9660;</span></div><div class="expand-body"><p>Armazena e recupera informações entre conversas diferentes.</p><div class="expand-example">&quot;Lembre que este projeto usa PostgreSQL&quot;<br>&rarr; Persiste e recupera em cada sessão.</div></div></div>
<div class="expand-card" onclick="toggleExpand(this)"><div class="expand-header"><div class="expand-header-left"><span class="expand-icon">&#127760;</span><div><div class="expand-name">Fetch</div><div class="expand-sub">HTTP e web scraping</div></div></div><span class="expand-chevron">&#9660;</span></div><div class="expand-body"><p>Faz chamadas HTTP a APIs externas e processa conteúdo web em tempo real.</p><div class="expand-example">&quot;Busque status da API do Stripe&quot;<br>&rarr; Acessa página e retorna resultado.</div></div></div>
<div class="exercise"><div class="exercise-title">&#128268; Exercício: Monte sua Stack MCP <span class="badge">PRÁTICO</span></div>
<div class="mcp-scenario-item"><p><strong>Cenário A:</strong> O agente precisa abrir PRs, avisar o time e consultar dados do banco após o deploy.</p><div class="mcp-checkboxes" id="mcp-a"><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="postgres"> &#128024; Postgres</label><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="github"> &#128025; GitHub</label><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="slack"> &#128172; Slack</label><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="filesystem"> &#128193; Filesystem</label><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="playwright"> &#127917; Playwright</label><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="fetch"> &#127760; Fetch</label></div><button class="check-btn" onclick="checkMcpA()">Verificar &rarr;</button><div class="mcp-result-text" id="mcp-a-result"></div></div>
<div class="mcp-scenario-item"><p><strong>Cenário B:</strong> Agente de suporte que lê tickets via API externa, busca soluções em docs internos e mantém contexto entre sessões.</p><div class="mcp-checkboxes" id="mcp-b"><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="fetch"> &#127760; Fetch (Jira)</label><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="filesystem"> &#128193; Filesystem (docs)</label><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="memory"> &#129504; Memory</label><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="postgres"> &#128024; Postgres</label><label class="mcp-cb-label" onclick="toggleMcp(this)"><input type="checkbox" value="playwright"> &#127917; Playwright</label></div><button class="check-btn" onclick="checkMcpB()">Verificar &rarr;</button><div class="mcp-result-text" id="mcp-b-result"></div></div>
</div>
</section>
<section id="frameworks"><div class="section-header"><div class="section-number">4</div><div><h2>Frameworks de Agentes</h2><p>Escolha a ferramenta certa para o tipo de automação que você quer construir.</p></div></div><div class="cards-grid-3">
<div class="fw-card"><div class="fw-header"><div class="fw-name">&#128674; CrewAI</div><div class="fw-stars">&#9733; 44k+</div></div><div class="fw-desc">Times de agentes com papéis definidos. Cada agente tem uma função (pesquisador, escritor, revisor) e colaboram como equipe.</div><div class="fw-use">Melhor para: <span>Pipelines com múltiplos especialistas</span></div><div style="margin-top:0.6rem;display:flex;gap:0.35rem;flex-wrap:wrap"><span class="tag tag-yellow">Python</span><span class="tag tag-orange">Multi-agent</span></div></div>
<div class="fw-card"><div class="fw-header"><div class="fw-name">&#128506;&#65039; LangGraph</div><div class="fw-stars">&#9733; 12k+</div></div><div class="fw-desc">Grafos de estado para orquestração complexa. Cada nó é uma ação, cada aresta uma transição. Controle total com retry e checkpointing.</div><div class="fw-use">Melhor para: <span>Workflows com lógica condicional</span></div><div style="margin-top:0.6rem;display:flex;gap:0.35rem;flex-wrap:wrap"><span class="tag tag-blue">Python/JS</span><span class="tag tag-teal">Stateful</span></div></div>
<div class="fw-card"><div class="fw-header"><div class="fw-name">&#128156; Claude Agent SDK</div><div class="fw-stars">&#9733; Anthropic</div></div><div class="fw-desc">SDK oficial da Anthropic com isolamento de contexto por subagente. Ideal quando cada agente precisa de contexto próprio.</div><div class="fw-use">Melhor para: <span>Agentes paralelos contextos isolados</span></div><div style="margin-top:0.6rem;display:flex;gap:0.35rem;flex-wrap:wrap"><span class="tag tag-purple">Python/TS</span><span class="tag tag-purple">Context isolation</span></div></div>
<div class="fw-card"><div class="fw-header"><div class="fw-name">&#127970; AutoGen</div><div class="fw-stars">&#9733; Microsoft</div></div><div class="fw-desc">Framework da Microsoft para agentes conversacionais. Focado em enterprise com segurança, auditoria e integração Azure.</div><div class="fw-use">Melhor para: <span>Projetos enterprise com compliance</span></div><div style="margin-top:0.6rem;display:flex;gap:0.35rem;flex-wrap:wrap"><span class="tag tag-blue">Python</span><span class="tag tag-blue">Enterprise</span></div></div>
<div class="fw-card"><div class="fw-header"><div class="fw-name">&#128311; Pydantic AI</div><div class="fw-stars">&#9733; 8k+</div></div><div class="fw-desc">Agentes com tipagem forte via Pydantic. Retornos validados, erros em compile time e integração natural com FastAPI.</div><div class="fw-use">Melhor para: <span>APIs com saídas type-safe</span></div><div style="margin-top:0.6rem;display:flex;gap:0.35rem;flex-wrap:wrap"><span class="tag tag-green">Python</span><span class="tag tag-green">Type-safe</span></div></div>
<div class="fw-card"><div class="fw-header"><div class="fw-name">&#129302; OpenAI Agents SDK</div><div class="fw-stars">&#9733; OpenAI</div></div><div class="fw-desc">SDK oficial da OpenAI com handoffs simples. Primitivas mínimas — sem magia, sem abstrações excessivas.</div><div class="fw-use">Melhor para: <span>Simplicidade com handoffs</span></div><div style="margin-top:0.6rem;display:flex;gap:0.35rem;flex-wrap:wrap"><span class="tag tag-yellow">Python</span><span class="tag tag-orange">Simples</span></div></div>
</div>
<div class="exercise"><div class="exercise-title">&#129513; Exercício: Qual Framework Usar? <span class="badge">MATRIZ</span></div>
<div id="fw-quiz">
<div class="matrix-q"><p>1. Linguagem principal?</p><div class="matrix-opts"><div class="matrix-opt" onclick="matrixSelect(this,'fwq1','python')">&#128013; Python</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq1','typescript')">&#128311; TypeScript</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq1','dotnet')">&#128156; .NET/C#</div></div></div>
<div class="matrix-q"><p>2. Tipo de automação?</p><div class="matrix-opts"><div class="matrix-opt" onclick="matrixSelect(this,'fwq2','team')">&#128101; Time de especialistas</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq2','graph')">&#128506;&#65039; Workflow condicional</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq2','structured')">&#128202; Saídas estruturadas</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq2','simple')">&#9889; Tarefa simples</div></div></div>
<div class="matrix-q"><p>3. Ecossistema principal?</p><div class="matrix-opts"><div class="matrix-opt" onclick="matrixSelect(this,'fwq3','anthropic')">&#128156; Anthropic</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq3','openai')">&#129001; OpenAI</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq3','microsoft')">&#128308; Microsoft/Azure</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq3','none')">&#129335; Nenhum</div></div></div>
<div class="matrix-q"><p>4. Prioridade?</p><div class="matrix-opts"><div class="matrix-opt" onclick="matrixSelect(this,'fwq4','speed')">&#9889; Velocidade</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq4','control')">&#127917; Controle</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq4','safety')">&#128274; Compliance</div><div class="matrix-opt" onclick="matrixSelect(this,'fwq4','stars')">&#11088; Comunidade</div></div></div>
<button class="quiz-submit" id="fw-quiz-btn" onclick="calcFwQuiz()" disabled>Ver recomendação &rarr;</button>
</div>
<div id="fw-quiz-result" class="quiz-result"><div class="result-icon" id="fwr-icon"></div><div class="result-name" id="fwr-name"></div><div class="result-desc" id="fwr-desc"></div><button onclick="resetFwQuiz()" style="margin-top:1rem;background:none;border:1px solid var(--border);color:var(--text-muted);padding:0.4rem 1rem;border-radius:6px;cursor:pointer;font-size:0.8rem">Refazer &rarr;</button></div>
</div></section>
<section id="modelos"><div class="section-header"><div class="section-number">5</div><div><h2>Modelos &amp; APIs</h2><p>Comparação técnica dos principais modelos em 2026.</p></div></div>
<div class="table-wrap"><table><thead><tr><th>Modelo</th><th>Contexto</th><th>Preço (input)</th><th>Melhor Para</th></tr></thead><tbody>
<tr><td><div class="model-name">Claude Opus 4</div><div class="model-maker">Anthropic</div></td><td><span class="context-pill">200k</span></td><td><span class="price-pill">$15/MTok</span></td><td style="color:var(--text-muted);font-size:0.82rem">Raciocínio complexo, agentes, código crítico</td></tr>
<tr><td><div class="model-name">Claude Sonnet 4</div><div class="model-maker">Anthropic</div></td><td><span class="context-pill">200k</span></td><td><span class="price-pill">$3/MTok</span></td><td style="color:var(--text-muted);font-size:0.82rem">Equilíbrio custo/qualidade, uso geral</td></tr>
<tr><td><div class="model-name">GPT-4o</div><div class="model-maker">OpenAI</div></td><td><span class="context-pill">128k</span></td><td><span class="price-pill">$2.5/MTok</span></td><td style="color:var(--text-muted);font-size:0.82rem">Multimodal (texto + imagem + áudio)</td></tr>
<tr><td><div class="model-name">GPT-o3</div><div class="model-maker">OpenAI</div></td><td><span class="context-pill">200k</span></td><td><span class="price-pill">$10/MTok</span></td><td style="color:var(--text-muted);font-size:0.82rem">Raciocínio matemático e lógico</td></tr>
<tr><td><div class="model-name">Gemini 2.5 Pro</div><div class="model-maker">Google</div></td><td><span class="context-pill">1M</span></td><td><span class="price-pill">$1.25/MTok</span></td><td style="color:var(--text-muted);font-size:0.82rem">Janela enorme, docs longos</td></tr>
<tr><td><div class="model-name">Llama 4 Scout</div><div class="model-maker">Meta (Open)</div></td><td><span class="context-pill">10M</span></td><td><span class="price-pill free">Open source</span></td><td style="color:var(--text-muted);font-size:0.82rem">Self-hosted, privacidade</td></tr>
<tr><td><div class="model-name">DeepSeek V3</div><div class="model-maker">DeepSeek</div></td><td><span class="context-pill">128k</span></td><td><span class="price-pill">$0.27/MTok</span></td><td style="color:var(--text-muted);font-size:0.82rem">Custo baixo, código e matemática</td></tr>
<tr><td><div class="model-name">Mistral Large</div><div class="model-maker">Mistral AI</div></td><td><span class="context-pill">128k</span></td><td><span class="price-pill">$2/MTok</span></td><td style="color:var(--text-muted);font-size:0.82rem">Europa (GDPR), multilíngue</td></tr>
</tbody></table></div>
<div class="exercise"><div class="exercise-title">&#127919; Exercício: Escolha o Modelo Certo <span class="badge">CENÁRIOS</span></div><p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:1.2rem">Escolha o modelo mais adequado para cada cenário.</p>
<div class="scenario-list">
<div class="scenario-item"><div class="scenario-num">1</div><div class="scenario-content"><p>Processar <strong>50 mil PDFs de contratos</strong> para extrair datas. Volume alto, texto simples.</p><select class="scenario-select" id="sc1" onchange="checkScenario(1,'deepseek')"><option value="">Escolher modelo...</option><option value="claude-opus">Claude Opus 4</option><option value="gpt-o3">GPT-o3</option><option value="deepseek">DeepSeek V3</option><option value="gemini">Gemini 2.5 Pro</option><option value="llama">Llama 4 Scout</option></select><div class="scenario-feedback" id="scf1"></div></div></div>
<div class="scenario-item"><div class="scenario-num">2</div><div class="scenario-content"><p>Agente autônomo precisa <strong>auditar segurança de sistema crítico</strong>, raciocinar sobre vulnerabilidades.</p><select class="scenario-select" id="sc2" onchange="checkScenario(2,'claude-opus')"><option value="">Escolher modelo...</option><option value="claude-opus">Claude Opus 4</option><option value="gpt-4o">GPT-4o</option><option value="deepseek">DeepSeek V3</option><option value="mistral">Mistral Large</option></select><div class="scenario-feedback" id="scf2"></div></div></div>
<div class="scenario-item"><div class="scenario-num">3</div><div class="scenario-content"><p>Startup europeia precisa de <strong>chatbot em 12 idiomas</strong>. GDPR obrigatório.</p><select class="scenario-select" id="sc3" onchange="checkScenario(3,'mistral')"><option value="">Escolher modelo...</option><option value="gpt-4o">GPT-4o</option><option value="claude-opus">Claude Opus 4</option><option value="mistral">Mistral Large</option><option value="gemini">Gemini 2.5 Pro</option></select><div class="scenario-feedback" id="scf3"></div></div></div>
<div class="scenario-item"><div class="scenario-num">4</div><div class="scenario-content"><p>Analisar <strong>repositório com 500k linhas de código</strong> de uma vez para documentação.</p><select class="scenario-select" id="sc4" onchange="checkScenario(4,'gemini')"><option value="">Escolher modelo...</option><option value="claude-sonnet">Claude Sonnet 4</option><option value="gpt-o3">GPT-o3</option><option value="gemini">Gemini 2.5 Pro</option><option value="deepseek">DeepSeek V3</option></select><div class="scenario-feedback" id="scf4"></div></div></div>
</div></div></section>
<section id="eval"><div class="section-header"><div class="section-number">6</div><div><h2>Eval &amp; Observabilidade</h2><p>Medir é melhorar — ferramentas para avaliar qualidade e monitorar produção.</p></div></div><div class="cards-grid">
<div class="card"><div class="card-icon" style="background:rgba(16,185,129,0.15)">&#129514;</div><h3>Promptfoo</h3><p>CLI open source para testar prompts. Roda centenas de casos com vários modelos em paralelo. Detecta regressões.</p><span class="tag tag-green">Open source</span><span class="tag tag-blue">CLI</span></div>
<div class="card"><div class="card-icon" style="background:rgba(139,92,246,0.15)">&#129504;</div><h3>Braintrust</h3><p>Plataforma completa de eval com datasets e scoring por LLM. Interface web para comparar runs.</p><span class="tag tag-purple">Plataforma</span><span class="tag tag-yellow">LLM-as-judge</span></div>
<div class="card"><div class="card-icon" style="background:rgba(59,130,246,0.15)">&#128269;</div><h3>LangSmith</h3><p>Tracing completo de chamadas LLM. Visualiza cada step de um agente, latência, custo e anomalias.</p><span class="tag tag-blue">Tracing</span><span class="tag tag-teal">LangChain nativo</span></div>
<div class="card"><div class="card-icon" style="background:rgba(245,158,11,0.15)">&#128202;</div><h3>Langfuse</h3><p>Analytics open source para aplicações LLM. Self-hostável, GDPR-friendly. Dashboard de uso e custo.</p><span class="tag tag-yellow">Open source</span><span class="tag tag-green">Self-hosted</span></div>
<div class="card"><div class="card-icon" style="background:rgba(236,72,153,0.15)">&#128640;</div><h3>Helicone</h3><p>Proxy transparente para qualquer API LLM. Zero mudança de código. Monitoramento e análise de custo.</p><span class="tag tag-pink">Proxy</span><span class="tag tag-orange">Zero-code</span></div>
</div>
<div class="card" style="margin-top:1rem;border-color:rgba(59,130,246,0.25);background:rgba(59,130,246,0.05)"><p style="font-size:0.875rem;color:var(--text-muted)">&#128161; <strong style="color:var(--text)">Combo recomendado:</strong> <strong style="color:var(--blue-light)">Promptfoo</strong> para eval local + <strong style="color:var(--purple-light)">Langfuse</strong> (OSS) em produção. Custo quase zero.</p></div>
</section>
<section id="generativa"><div class="section-header"><div class="section-number">7</div><div><h2>IA Generativa Além do Texto</h2><p>Imagens, áudio, música, vídeo e transcrição.</p></div></div><div class="cards-grid">
<div class="card"><div class="card-icon" style="background:rgba(245,158,11,0.15)">&#127912;</div><h3>DALL-E 3 / Midjourney</h3><p>Geração de imagens por texto. DALL-E 3 integrado à API OpenAI. Midjourney para arte de alta qualidade.</p><span class="tag tag-yellow">Imagens</span><span class="tag tag-orange">Text-to-image</span></div>
<div class="card"><div class="card-icon" style="background:rgba(139,92,246,0.15)">&#127908;</div><h3>ElevenLabs</h3><p>Síntese de voz de altíssima qualidade. Clone de voz com 1 min de áudio. API para texto-para-fala.</p><span class="tag tag-purple">Voz</span><span class="tag tag-teal">Voice clone</span></div>
<div class="card"><div class="card-icon" style="background:rgba(236,72,153,0.15)">&#127925;</div><h3>Suno</h3><p>Geração de músicas completas (letra + melodia + voz) a partir de texto. Para demos e protótipos.</p><span class="tag tag-pink">Música</span><span class="tag tag-pink">Text-to-song</span></div>
<div class="card"><div class="card-icon" style="background:rgba(59,130,246,0.15)">&#127902;</div><h3>Runway / Sora</h3><p>Geração de vídeo a partir de texto. Runway Gen-3 disponível. Sora para vídeos mais longos.</p><span class="tag tag-blue">Vídeo</span><span class="tag tag-blue">Text-to-video</span></div>
<div class="card"><div class="card-icon" style="background:rgba(16,185,129,0.15)">&#127908;</div><h3>Whisper</h3><p>Transcrição de áudio da OpenAI. Open source, rodável localmente. 99 idiomas, alta acurácia.</p><span class="tag tag-green">Transcrição</span><span class="tag tag-green">Open source</span></div>
<div class="card"><div class="card-icon" style="background:rgba(245,158,11,0.15)">&#128218;</div><h3>NotebookLM</h3><p>Ferramenta do Google que transforma documentos em conversas. Gera podcasts sobre o conteúdo.</p><span class="tag tag-yellow">Pesquisa</span><span class="tag tag-orange">Google</span></div>
</div></section>
<section id="quiz-final"><div class="section-header"><div class="section-number">8</div><div><h2>Quiz Final — Módulo 7</h2><p>Teste seu conhecimento.</p></div></div>
<div class="final-question" id="fq-1"><p>1. 1. Qual protocolo aberto conecta modelos a ferramentas externas de forma padronizada?</p><div class="fq-options">
<div class="fq-opt" onclick="answerFQ(1,'a','c')">A) REST API</div>
<div class="fq-opt" onclick="answerFQ(1,'b','c')">B) GraphQL</div>
<div class="fq-opt" onclick="answerFQ(1,'c','c')">C) MCP — Model Context Protocol</div>
<div class="fq-opt" onclick="answerFQ(1,'d','c')">D) WebSocket</div>
</div><div class="fq-feedback" id="fqf-1">MCP (Model Context Protocol) é o protocolo aberto que conecta o modelo a qualquer ferramenta externa.</div></div>
<div class="final-question" id="fq-2"><p>2. 2. Qual modelo tem a maior janela de contexto entre os comerciais?</p><div class="fq-options">
<div class="fq-opt" onclick="answerFQ(2,'a','b')">A) Claude Opus 4 (200k)</div>
<div class="fq-opt" onclick="answerFQ(2,'b','b')">B) Gemini 2.5 Pro (1M)</div>
<div class="fq-opt" onclick="answerFQ(2,'c','b')">C) GPT-4o (128k)</div>
<div class="fq-opt" onclick="answerFQ(2,'d','b')">D) DeepSeek V3 (128k)</div>
</div><div class="fq-feedback" id="fqf-2">Gemini 2.5 Pro tem 1 milhão de tokens de contexto entre os modelos comerciais.</div></div>
<div class="final-question" id="fq-3"><p>3. 3. Qual framework da Microsoft é mais indicado para projetos enterprise com Azure?</p><div class="fq-options">
<div class="fq-opt" onclick="answerFQ(3,'a','c')">A) CrewAI</div>
<div class="fq-opt" onclick="answerFQ(3,'b','c')">B) LangGraph</div>
<div class="fq-opt" onclick="answerFQ(3,'c','c')">C) AutoGen</div>
<div class="fq-opt" onclick="answerFQ(3,'d','c')">D) Pydantic AI</div>
</div><div class="fq-feedback" id="fqf-3">AutoGen é o framework da Microsoft, focado em enterprise com auditoria e integração Azure.</div></div>
<div class="final-question" id="fq-4"><p>4. 4. Qual ferramenta funciona como proxy transparente sem alterar o código?</p><div class="fq-options">
<div class="fq-opt" onclick="answerFQ(4,'a','d')">A) Promptfoo</div>
<div class="fq-opt" onclick="answerFQ(4,'b','d')">B) Braintrust</div>
<div class="fq-opt" onclick="answerFQ(4,'c','d')">C) LangSmith</div>
<div class="fq-opt" onclick="answerFQ(4,'d','d')">D) Helicone</div>
</div><div class="fq-feedback" id="fqf-4">Helicone é um proxy transparente — intercepta chamadas sem precisar alterar nenhuma linha de código.</div></div>
<div class="final-question" id="fq-5"><p>5. 5. Para geração de música completa (letra + melodia + voz) qual ferramenta usar?</p><div class="fq-options">
<div class="fq-opt" onclick="answerFQ(5,'a','b')">A) ElevenLabs</div>
<div class="fq-opt" onclick="answerFQ(5,'b','b')">B) Suno</div>
<div class="fq-opt" onclick="answerFQ(5,'c','b')">C) Whisper</div>
<div class="fq-opt" onclick="answerFQ(5,'d','b')">D) Runway</div>
</div><div class="fq-feedback" id="fqf-5">Suno cria músicas completas a partir de texto. ElevenLabs = voz, Whisper = transcrição, Runway = vídeo.</div></div>
<div class="completion-banner" id="completion-banner"><div class="completion-trophy">&#127942;</div><div class="score-ring" id="final-score-ring">0/5</div><div class="completion-title">Módulo 7 Completo!</div><div class="completion-sub" id="completion-msg">Você dominou o arsenal de ferramentas de IA.</div><a href="../index.html" class="btn-home">&larr; Voltar ao Início</a></div>
</section></main>
<script>
// TOOL QUIZ
const toolAnswers={};
function selectOpt(el,qid,val){document.querySelectorAll('#'+qid+' .quiz-option').forEach(e=>e.classList.remove('selected'));el.classList.add('selected');toolAnswers[qid]=val;document.getElementById('tool-quiz-btn').disabled=Object.keys(toolAnswers).length<5;}
function calcToolQuiz(){
var a=toolAnswers,s={copilot:0,claudecode:0,cursor:0,windsurf:0,aider:0};
if(a.tq1==="a"){s.claudecode+=2;s.aider+=2;}
if(a.tq1==="b"){s.cursor+=2;s.copilot+=1;s.windsurf+=1;}
if(a.tq1==="c"){s.claudecode+=1;s.cursor+=1;}
if(a.tq2==="a"){s.aider+=3;s.windsurf+=2;}if(a.tq2==="b"){s.cursor+=2;s.copilot+=2;}if(a.tq2==="c"){s.claudecode+=3;}
if(a.tq3==="a"){s.copilot+=3;}if(a.tq3==="b"){s.claudecode+=3;}if(a.tq3==="c"){s.cursor+=3;s.windsurf+=2;}
if(a.tq4==="a"){s.aider+=3;}if(a.tq4==="b"){s.copilot+=2;s.claudecode+=2;}if(a.tq4==="c"){s.cursor+=2;s.windsurf+=2;}
if(a.tq5==="a"){s.copilot+=2;}if(a.tq5==="b"){s.aider+=1;}
var w=Object.entries(s).sort((x,y)=>y[1]-x[1])[0][0];
var res={copilot:{name:"GitHub Copilot",desc:"Integração perfeita com o GitHub e autocomplete fluido.",tags:"<span class=tag-green>10/mes</span>"},
claudecode:{name:"Claude Code",desc:"Agente real no terminal.",tags:"<span class=tag-purple>Autônomo</span>"},
cursor:{name:"Cursor",desc:"IDE com IA profunda.",tags:"<span class=tag-blue>20/mes</span>"},
windsurf:{name:"Windsurf",desc:"IDE moderno, Cascade, free tier.",tags:"<span class=tag-green>Free</span>"},
aider:{name:"Aider",desc:"CLI open source, zero custo.",tags:"<span class=tag-yellow>OSS</span>"}};
var r=res[w];
document.getElementById("tqr-name").textContent=r.name;
document.getElementById("tqr-desc").textContent=r.desc;
document.getElementById("tqr-tags").innerHTML=r.tags;
document.getElementById("tool-quiz").style.display="none";
document.getElementById("tool-quiz-result").classList.add("show");}
function resetToolQuiz(){Object.keys(toolAnswers).forEach(k=>delete toolAnswers[k]);document.querySelectorAll("#tool-quiz .quiz-option").forEach(e=>e.classList.remove("selected"));document.getElementById("tool-quiz-btn").disabled=true;document.getElementById("tool-quiz").style.display="block";document.getElementById("tool-quiz-result").classList.remove("show");}
function toggleExpand(card){card.classList.toggle("open");}
function toggleMcp(label){label.classList.toggle("checked");}
function checkMcpA(){var checked=Array.from(document.querySelectorAll("#mcp-a .mcp-cb-label.checked input")).map(i=>i.value);var correct=["postgres","github","slack"];var hits=correct.filter(c=>checked.includes(c));var extra=checked.filter(c=>!correct.includes(c));var el=document.getElementById("mcp-a-result");el.classList.add("show");if(hits.length===3&&extra.length===0){el.style.color="var(--green-light)";el.textContent="Perfeito! Postgres + GitHub + Slack é o trio ideal.";}else{el.style.color="var(--text-muted)";el.textContent="Os ideais são: Postgres + GitHub + Slack.";}}
function checkMcpB(){var checked=Array.from(document.querySelectorAll("#mcp-b .mcp-cb-label.checked input")).map(i=>i.value);var correct=["fetch","filesystem","memory"];var hits=correct.filter(c=>checked.includes(c));var extra=checked.filter(c=>!correct.includes(c));var el=document.getElementById("mcp-b-result");el.classList.add("show");if(hits.length===3&&extra.length===0){el.style.color="var(--green-light)";el.textContent="Excelente! Fetch + Filesystem + Memory cobre tudo.";}else{el.style.color="var(--text-muted)";el.textContent="Os ideais são: Fetch + Filesystem + Memory.";}}
var fwAnswers={};
function matrixSelect(el,qid,val){document.querySelectorAll("[onclick*='"+qid+"']").forEach(e=>e.classList.remove("selected"));el.classList.add("selected");fwAnswers[qid]=val;document.getElementById("fw-quiz-btn").disabled=Object.keys(fwAnswers).length<4;}
function calcFwQuiz(){var a=fwAnswers,s={crewai:0,langgraph:0,agentsdk:0,autogen:0,pydantic:0,openai:0};if(a.fwq1==="typescript"){s.agentsdk+=2;s.openai+=2;}if(a.fwq1==="dotnet"){s.agentsdk+=3;}if(a.fwq1==="python"){s.crewai+=1;s.langgraph+=1;s.pydantic+=1;}if(a.fwq2==="team"){s.crewai+=3;}if(a.fwq2==="graph"){s.langgraph+=3;}if(a.fwq2==="structured"){s.pydantic+=3;}if(a.fwq2==="simple"){s.openai+=3;}if(a.fwq3==="anthropic"){s.agentsdk+=3;}if(a.fwq3==="openai"){s.openai+=3;}if(a.fwq3==="microsoft"){s.autogen+=3;}if(a.fwq4==="speed"){s.openai+=2;}if(a.fwq4==="control"){s.langgraph+=2;s.agentsdk+=1;}if(a.fwq4==="safety"){s.autogen+=2;}if(a.fwq4==="stars"){s.crewai+=2;}var w=Object.entries(s).sort((x,y)=>y[1]-x[1])[0][0];var res={crewai:{name:"CrewAI",desc:"Times de agentes com papéis definidos. 44k+ stars."},langgraph:{name:"LangGraph",desc:"Grafos de estado para workflows complexos."},agentsdk:{name:"Claude Agent SDK",desc:"Contextos isolados por subagente, SDK da Anthropic."},autogen:{name:"AutoGen",desc:"Enterprise com Azure e compliance."},pydantic:{name:"Pydantic AI",desc:"Saídas type-safe com Python e FastAPI."},openai:{name:"OpenAI Agents SDK",desc:"Simplicidade com handoffs."}};var r=res[w];document.getElementById("fwr-name").textContent=r.name;document.getElementById("fwr-desc").textContent=r.desc;document.getElementById("fw-quiz").style.display="none";document.getElementById("fw-quiz-result").classList.add("show");}
function resetFwQuiz(){Object.keys(fwAnswers).forEach(k=>delete fwAnswers[k]);document.querySelectorAll("#fw-quiz .matrix-opt").forEach(e=>e.classList.remove("selected"));document.getElementById("fw-quiz-btn").disabled=true;document.getElementById("fw-quiz").style.display="block";document.getElementById("fw-quiz-result").classList.remove("show");}
function checkScenario(num,correct){var sel=document.getElementById("sc"+num);var fb=document.getElementById("scf"+num);var val=sel.value;if(!val)return;fb.className="scenario-feedback";if(val===correct){fb.classList.add("correct");var msgs={1:"Correto! DeepSeek V3 a 0.27/MTok ideal para volume alto com tarefa simples.",2:"Correto! Claude Opus 4 para raciocínio crítico em segurança.",3:"Correto! Mistral Large europeu, GDPR-compliant e multilíngue.",4:"Correto! Gemini 2.5 Pro com 1M tokens para 500k linhas."};fb.textContent="✅ "+msgs[num];}else{fb.classList.add("wrong");var hints={1:"Pense no custo para volume alto.",2:"Pense na criticidade — alto impacto exige melhor modelo.",3:"GDPR obriga dados na Europa.",4:"500k linhas precisam de 1M+ tokens de contexto."};fb.textContent="❌ "+hints[num];}}
var fqScore=0,fqAnswered={};
function answerFQ(qnum,chosen,correct){if(fqAnswered[qnum])return;fqAnswered[qnum]=true;var q=document.getElementById("fq-"+qnum);var opts=q.querySelectorAll(".fq-opt");var lets=["a","b","c","d"];opts.forEach((opt,i)=>{opt.style.pointerEvents="none";if(lets[i]===correct)opt.classList.add("correct");else if(lets[i]===chosen&&chosen!==correct)opt.classList.add("wrong");});document.getElementById("fqf-"+qnum).classList.add("show");if(chosen===correct){fqScore++;q.classList.add("answered-correct");}else{q.classList.add("answered-wrong");}if(Object.keys(fqAnswered).length===5)setTimeout(showCompletion,600);}
function showCompletion(){document.getElementById("final-score-ring").textContent=fqScore+"/5";var msg=fqScore===5?"Pontuação perfeita! Arsenal dominado completamente.":fqScore>=4?"excelente! Pronto para usar as ferramentas certas.":fqScore>=3?"Bom trabalho! Revise onde errou.":"Continue estudando!";document.getElementById("completion-msg").textContent=msg;var b=document.getElementById("completion-banner");b.classList.add("show");b.scrollIntoView({behavior:"smooth",block:"start"});try{var k="ai-training-completed-v1",d=JSON.parse(localStorage.getItem(k)||"{}" );if(!d.completed)d.completed=[];if(!d.completed.includes(7)){d.completed.push(7);localStorage.setItem(k,JSON.stringify(d));}}catch(e){}}
</script>
</body>
</html>